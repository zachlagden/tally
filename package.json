{
  "name": "@zachlagden/tally",
  "version": "0.1.0",
  "description": "Code statistics for your terminal: lines, comments, functions, classes and complexity across 37 languages, counted with tree-sitter.",
  "keywords": [
    "cli",
    "tui",
    "loc",
    "cloc",
    "tokei",
    "code-statistics",
    "lines-of-code",
    "ink",
    "tree-sitter"
  ],
  "license": "MIT",
  "homepage": "https://github.com/zachlagden/tally#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zachlagden/tally.git"
  },
  "bugs": {
    "url": "https://github.com/zachlagden/tally/issues"
  },
  "author": "Zach Lagden <zach@zachlagden.uk>",
  "type": "module",
  "bin": {
    "tally": "./dist/cli.js"
  },
  "files": [
    "dist",
    "wasm",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node dist/cli.js\"",
    "build": "tsup",
    "start": "node dist/cli.js",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "asciichart": "^1.5.25",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ink": "^7.0.3",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.0",
    "ink-spinner": "^5.0.0",
    "p-limit": "^6.1.0",
    "react": "^19.2.0",
    "react-devtools-core": "^6.1.2",
    "terminal-link": "^3.0.0",
    "tinyglobby": "^0.2.10",
    "tree-sitter-wasms": "^0.1.12",
    "web-tree-sitter": "^0.24.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
